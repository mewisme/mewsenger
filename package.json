{
  "name": "mewsenger",
  "private": true,
  "version": "0.2.1",
  "description": "A fast, native Windows desktop client for Messenger with multiple accounts, native notifications and privacy tools.",
  "author": "Mew",
  "license": "MIT",
  "homepage": "https://github.com/mewisme/mewsenger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mewisme/mewsenger.git"
  },
  "bugs": {
    "url": "https://github.com/mewisme/mewsenger/issues"
  },
  "keywords": [
    "messenger",
    "tauri",
    "desktop",
    "windows",
    "multi-account",
    "react",
    "rust"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "version:check": "node scripts/verify-version.mjs",
    "changelog": "node scripts/changelog.mjs --write",
    "preview": "vite preview",
    "tauri": "tauri",
    "app-dev": "tauri dev",
    "app-build": "tauri build",
    "app-sign": "rm ./key && rm ./key.pub && pnpm tauri signer generate -w key"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^30.1.3",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0"
  }
}
