{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "webviews": ["status"],
  "permissions": [
    "core:default",
    "allow-show-credits",
    "allow-show-settings",
    "allow-current-status",
    "allow-test-notification",
    "allow-reveal-last-download",
    "allow-get-update-state",
    "allow-check-update",
    "allow-install-update",
    "allow-get-diagnostics"
  ]
}
