{
  "identifier": "settings",
  "description": "Local settings window",
  "webviews": [
    "settings"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "core:window:allow-close",
    "allow-get-preferences",
    "allow-set-preference",
    "allow-set-theme-preference",
    "allow-set-update-schedule",
    "allow-open-project-link",
    "allow-get-update-state",
    "allow-check-update",
    "allow-install-update",
    "allow-get-diagnostics",
    "allow-test-notification",
    "allow-list-accounts",
    "allow-add-account",
    "allow-remove-account",
    "allow-open-account",
    "allow-set-settings-placement",
    "allow-close-settings",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
