{
  "identifier": "messenger-notifications",
  "description": "Allow the Messenger site to deliver bounded notification events",
  "webviews": ["messenger"],
  "local": false,
  "remote": {
    "urls": [
      "https://www.messenger.com/*",
      "https://messenger.com/*"
    ]
  },
  "permissions": [
    "allow-notification-event"
  ]
}