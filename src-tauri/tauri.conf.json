{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mewsenger",
  "version": "0.2.1",
  "identifier": "com.mew.mewsenger",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:14871",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Mew",
    "copyright": "Copyright (c) 2024 Mew",
    "category": "SocialNetworking",
    "shortDescription": "Desktop client for Messenger",
    "longDescription": "Mewsenger wraps Messenger in a native window with multiple accounts as tabs, native notifications, an unread badge, privacy tools and signed automatic updates.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
